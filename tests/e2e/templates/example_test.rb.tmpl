require "test_helper"

class ExampleTest < E2ETest
  # Happy path: encrypt the fixture, confirm the ciphertext grew, decrypt, and
  # confirm the result is byte-for-byte identical to the original.
  def test_round_trip_matches_original
    input  = Paladin::LOREM
    cipher = tmp("cipher.paladin")
    plain  = tmp("decrypted.txt")
    env    = { "PW" => DEFAULT_PASSWORD }

    enc = paladin("--encrypt", input, "--output", cipher,
                   "--password-env", "PW", env: env)
    assert_status enc, 0
    assert_size_grew input, cipher

    # Pass --output so the filename restored from the header can't clobber a
    # fixture.
    dec = paladin("--decrypt", cipher, "--output", plain,
                   "--password-env", "PW", env: env)
    assert_status dec, 0
    assert_identical input, plain
  end

